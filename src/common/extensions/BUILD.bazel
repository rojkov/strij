load("//bazel:build_system.bzl", "strij_cc_library")

# Loader implementations behind the public Scheduler contracts: resolve an
# ExtensionConfig name to a registered factory and instantiate the scheduler.
# Framework-internal only; the contracts themselves live under
# //include/strij/extensions.
strij_cc_library(
    name = "scheduler_loader_lib",
    srcs = ["scheduler.cc"],
    hdrs = ["scheduler_loader.hh"],
    visibility = ["//visibility:public"],
    deps = [
        "//api/common/config:config_cc_proto",
        "//include/strij/extensions:extension_registry_lib",
        "//include/strij/extensions:factory_context_lib",
        "//include/strij/extensions:scheduler_interface",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@protobuf",
    ],
)
