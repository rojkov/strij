load("//bazel:build_system.bzl", "carrot_cc_library")

carrot_cc_library(
    name = "protocol_parser",
    hdrs = ["protocol_parser.hh"],
)

carrot_cc_library(
    name = "message_handler",
    hdrs = ["message_handler.hh"],
)

carrot_cc_library(
    name = "chunk_lib",
    srcs = ["chunk.cc"],
    hdrs = ["chunk.hh"],
)

carrot_cc_library(
    name = "llhttp_parser_lib",
    srcs = ["llhttp_parser.cc"],
    hdrs = ["llhttp_parser.hh"],
    visibility = ["//visibility:public"],
    deps = [
        ":chunk_lib",
        ":protocol_parser",
        "//:llhttp",
        "//src/core/logging:log_lib",
    ],
)

carrot_cc_library(
    name = "connection_lib",
    srcs = ["connection.cc"],
    hdrs = ["connection.hh"],
    deps = [
        ":message_handler",
        ":protocol_parser",
        "//include/carrot/event:dispatcher_interface",
        "//include/carrot/event:io_object_interface",
    ],
)

carrot_cc_library(
    name = "http_echo_handler_lib",
    srcs = ["http_echo_handler.cc"],
    hdrs = ["http_echo_handler.hh"],
    visibility = ["//visibility:public"],
    deps = [
        ":connection_lib",
        ":message_handler",
    ],
)

carrot_cc_library(
    name = "tcp_listener_lib",
    srcs = ["tcp_listener.cc"],
    hdrs = ["tcp_listener.hh"],
    visibility = ["//visibility:public"],
    deps = [
        ":connection_lib",
        "//src/core/logging:log_lib",
    ],
)
