load("//bazel:build_system.bzl", "strij_cc_library")

# The Open Workflow interpreter handler: the `call: strij` projection, the
# data-chain/expression engine, the resumable step loop, and the handler that
# adapts a submitted document to it.
strij_cc_library(
    name = "openworkflow_task_handler_lib",
    srcs = [
        "call_strij.cc",
        "data_chain.cc",
        "expression.cc",
        "interpreter.cc",
        "openworkflow_task_handler.cc",
    ],
    hdrs = [
        "call_strij.hh",
        "data_chain.hh",
        "errors.hh",
        "expression.hh",
        "interpreter.hh",
        "openworkflow_task_handler.hh",
    ],
    visibility = [
        "//src/nodeagent/exe:__pkg__",
        "//test:__subpackages__",
    ],
    deps = [
        "//api/common/config:config_cc_proto",
        "//api/common/node:node_cc_proto",
        "//api/common/task:task_cc_proto",
        "//api/nodeagent/extensions/task_handlers/openworkflow:openworkflow_task_handler_cc_proto",
        "//include/strij/extensions:extension_registry_lib",
        "//include/strij/gateway:result_receiver_storage_interface",
        "//include/strij/nodeagent:child_task_submitter_interface",
        "//include/strij/nodeagent:task_handlers_interface",
        "//src/common/core/utils:jv_lib",
        "//src/common/core/utils:task_id_lib",
        "//src/common/extensions/evaluators:evaluator_interface",
        "//src/common/loaders:evaluator_loader_lib",
        "//src/openworkflow:openworkflow_model_lib",
        "//src/openworkflow:value_jv_lib",
        "//src/openworkflow/parser:openworkflow_parser_lib",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@protobuf",
    ],
    alwayslink = True,
)
