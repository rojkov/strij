SystemHeaders: false
HeaderFilterRegex: '.*src'
Checks:
  - '-*'
  - 'clang-analyzer-*'
  - 'concurrency-*'
  - 'cppcoreguidelines-*'
  - 'modernize-*'
  - 'misc-*'
  - '-misc-no-recursion'
  - 'perforamnce-*'
  - 'portability-*'
  - 'readability-*'
CheckOptions:
  readability-identifier-length.MinimumLoopCounterNameLength: '2'
  readability-function-cognitive-complexity.Threshold: 25
