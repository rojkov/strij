load("@rules_foreign_cc//foreign_cc:configure.bzl", "configure_make")
load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

configure_make(
    name = "liburing",
    args = ["-j8"],
    configure_in_place = True,
    lib_source = "@liburing//:all_srcs",
    out_static_libs = ["liburing.a"],
    visibility = ["//visibility:public"],
)

configure_make(
    name = "libjq",
    args = ["-j8"],
    configure_in_place = True,
    configure_options = [
        "--disable-maintainer-mode",
        "--disable-shared",
        "--with-oniguruma=builtin",
    ],
    lib_source = "@jq//:all_srcs",
    # Builtin oniguruma (regex support behind test()/match()/capture()) is
    # vendored in-tree and installed separately; the probe target must link
    # both archives.
    out_static_libs = ["libjq.a", "libonig.a"],
    visibility = ["//visibility:public"],
)

cmake(
    name = "llhttp",
    cache_entries = {
        "LLHTTP_BUILD_STATIC_LIBS": "ON",
        "LLHTTP_BUILD_SHARED_LIBS": "OFF",
    },
    lib_source = "@llhttp//:all_srcs",
    out_static_libs = ["libllhttp.a"],
    visibility = ["//visibility:public"],
)
