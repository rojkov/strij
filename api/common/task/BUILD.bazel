load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "task_proto",
    srcs = ["task.proto"],
    strip_import_prefix = "/api",
    visibility = ["//visibility:public"],
    deps = ["//api/common/node:node_proto"],
)

cc_proto_library(
    name = "task_cc_proto",
    visibility = ["//visibility:public"],
    deps = [":task_proto"],
)

proto_library(
    name = "probe_proto",
    srcs = ["probe.proto"],
    strip_import_prefix = "/api",
    visibility = ["//visibility:public"],
    deps = ["//api/common/node:node_proto"],
)

cc_proto_library(
    name = "probe_cc_proto",
    visibility = ["//visibility:public"],
    deps = [":probe_proto"],
)
